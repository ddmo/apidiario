{
  "name": "apidiario",
  "private": true,
  "version": "0.10.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "router:gen": "tsr generate",
    "db:types": "node scripts/gen-db-types.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "@tanstack/query-async-storage-persister": "^5",
    "@tanstack/react-query": "^5",
    "@tanstack/react-query-persist-client": "^5",
    "@tanstack/react-router": "^1",
    "@types/leaflet": "^1.9.21",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-cli": "^1.166.40",
    "@tanstack/router-plugin": "^1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^15",
    "jsdom": "^29.1.1",
    "prettier": "^3",
    "supabase": "^2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vite-plugin-pwa": "^0.21",
    "vitest": "^4.1.5",
    "web-push": "^3.6.7",
    "wrangler": "^4.90.0"
  }
}
